{% set zig_cc = os.path.abspath(os.path.join(profile_dir, "../../../tools/zig-cc")) %}
{% set zig_cxx = os.path.abspath(os.path.join(profile_dir, "../../../tools/zig-cxx")) %}
{% set zig_ar = os.getenv("ZIG_AR") %}
{% set zig_ranlib = os.getenv("ZIG_RANLIB") %}

[settings]
os=Linux
arch=x86
build_type=Release
compiler=clang
compiler.version=21
compiler.cppstd=17
compiler.libcxx=libc++

[conf]
# Conan describes Zig's Clang-compatible frontend as Clang while selecting Zig's executables explicitly.
tools.build:compiler_executables={'c': '{{ zig_cc }}', 'cpp': '{{ zig_cxx }}'}
tools.build:cflags=['--target=x86-linux-gnu.2.3']
tools.build:cxxflags=['--target=x86-linux-gnu.2.3']
tools.build:sharedlinkflags=['--target=x86-linux-gnu.2.3']
tools.build:exelinkflags=['--target=x86-linux-gnu.2.3']
tools.gnu:pkg_config=pkg-config

[buildenv]
AR={{ zig_ar }}
RANLIB={{ zig_ranlib }}
