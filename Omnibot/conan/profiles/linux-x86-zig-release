{% set zig_cc = os.path.abspath(os.path.join(profile_dir, "../../../tools/zig-cc")) %}
{% set zig_cxx = os.path.abspath(os.path.join(profile_dir, "../../../tools/zig-cxx")) %}
{% set zig_ar = os.getenv("ZIG_AR") %}
{% set zig_ranlib = os.getenv("ZIG_RANLIB") %}

[settings]
os=Linux
arch=x86
build_type=Release
compiler=clang
compiler.version=21
compiler.cppstd=17
compiler.libcxx=libc++

[conf]
# Zig emits DWARF by default, so the release profile disables it explicitly.
tools.build:compiler_executables={'c': '{{ zig_cc }}', 'cpp': '{{ zig_cxx }}'}
tools.build:cflags=['--target=x86-linux-gnu.2.3', '-g0']
tools.build:cxxflags=['--target=x86-linux-gnu.2.3', '-g0']
# Zig's bundled runtime objects contain DWARF, so discard it during release links.
tools.build:sharedlinkflags=['--target=x86-linux-gnu.2.3', '-Wl,--strip-debug']
tools.build:exelinkflags=['--target=x86-linux-gnu.2.3', '-Wl,--strip-debug']
tools.gnu:pkg_config=pkg-config

[buildenv]
AR={{ zig_ar }}
RANLIB={{ zig_ranlib }}
